        {
          "id": "68878e52-8921-4416-a044-e049c5174b60",
          "name": "get-translations",
          "request": {
            "name": "get-translations",
            "description": {
              "content": "Retrieves a list of all translatable fields and their translations. \n \n Use the `locale` parameter to return translations for a specific locale. If a field doesn't have a translation for the requested locale, the value defaults to English, `en`. \n \n  If no locale is specified, all translations are returned, including the default English values.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "translations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "The locale code. Both ISO-639 language code and ISO-3166 country code formats are supported."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The publisher token.",
                "key": "x-publisher-token",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
