                "name": "x-publisher-token",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "publisherOfferId",
                "value": "",
                "type": "path",
                "description": "Store Refresh Popup ID. This is the offer's **External ID** value in the Publisher Dashboard."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a Store Refresh popup offer."
        }
      ]
