            "method": "POST",
            "url": "https://api.appcharge.com/v2/offer",
            "headers": [
              {
                "name": "x-publisher-token",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a Store Refresh popup offer. Triggered when a player refreshes the web store."
        },
        {
          "info": {
            "name": "Update an existing Store Refresh Popup",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.appcharge.com/v2/offer/:publisherOfferId",
            "headers": [
